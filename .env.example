# Copy this file to .env only if you want to override a default.
# A missing .env is fine: the app falls back to the values below.

# Where the app stores its ChromaDB, images and settings.json.
# Relative paths are resolved from the directory you start the app in.
# Default: ./data
FACE_DATA_DIR=./data

# The Streamlit app itself reads no API keys. The legacy image scripts and
# this former variable are not used by the app; set your own key here only if
# you run those scripts. Never commit the real .env.
# GOOGLE_API_KEY=your-key-here
